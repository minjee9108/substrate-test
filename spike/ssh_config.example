# Spike path: ssh -> ProxyCommand -> kubectl ate proxy -> router -> sshbridge
Host ssh-5
  HostName ssh-5
  User dev
  IdentityFile ~/.ssh/substrate/id_spike
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ProxyCommand ~/.ssh/substrate/ate-ssh-proxy.sh ate-spike-ssh %h

# Final path: ssh -> in-cluster gateway (certificate login)
Host ssh-7-cert
  HostName 127.0.0.1
  Port 2225
  User ssh-7.ate-spike-ssh
  IdentityFile ~/.ssh/substrate/id_alice
  CertificateFile ~/.ssh/substrate/id_alice-cert.pub
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
